# Peter Barrett Criminal Defense - Apache config for GoDaddy cPanel (Linux)
# Static site. Every page is a directory with an index.html, so clean URLs
# work natively and no rewrite rules are needed to serve the pages.

Options -Indexes
DirectoryIndex index.html

# --- Canonical host and scheme: https + www ---------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.barrettcrimelaw.com/$1 [R=301,L]
</IfModule>

# --- Trailing slash on directories (avoids duplicate URLs) -------------------
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# --- 301s from the old WordPress URLs ---------------------------------------
# 67 rules. The 63 blog posts are absent on purpose: they are served
# at their original addresses, so they must NOT be redirected.
<IfModule mod_alias.c>
  RedirectMatch 301 "^/federal-crimes/money-laundering/cybercrimes/?$" "/practice-areas/federal-crimes/"
  RedirectMatch 301 "^/federal-crimes/federal-drug-conspiracy/?$" "/practice-areas/drug-crimes/"
  RedirectMatch 301 "^/dallas-tx-criminal-defense-law-office/?$" "/"
  RedirectMatch 301 "^/contact/free-consultation-drug-crime/?$" "/practice-areas/drug-crimes/"
  RedirectMatch 301 "^/federal-crimes/other-federal-crimes/?$" "/practice-areas/federal-crimes/"
  RedirectMatch 301 "^/category/intoxication-manslaughter/?$" "/practice-areas/dwi-defense/"
  RedirectMatch 301 "^/texas-crimes/dallas-robbery-lawyer/?$" "/practice-areas/violent-crimes/"
  RedirectMatch 301 "^/texas-crimes/child-sexual-assault/?$" "/practice-areas/sexual-offenses/"
  RedirectMatch 301 "^/texas-crimes/probation-violations/?$" "/blog/arrested-in-dallas-first-48-hours/"
  RedirectMatch 301 "^/federal-crimes/health-care-fraud/?$" "/practice-areas/federal-crimes/"
  RedirectMatch 301 "^/federal-crimes/money-laundering/?$" "/practice-areas/federal-crimes/"
  RedirectMatch 301 "^/federal-crimes/securities-fraud/?$" "/practice-areas/federal-crimes/"
  RedirectMatch 301 "^/category/community-supervision/?$" "/blog/arrested-in-dallas-first-48-hours/"
  RedirectMatch 301 "^/texas-crimes/child-pornography/?$" "/practice-areas/sexual-offenses/"
